APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database configuration
DATABASE_URL=sqlite:///./news_classifier.db

# MLflow tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=news-topic-classification
MLFLOW_MODEL_NAME=news-topic-classifier

# Model & Transformer configuration
MODEL_VERSION=v1.0
MODEL_PATH=./models
USE_TRANSFORMER_IF_AVAILABLE=true
EVAL_THRESHOLD_F1=0.80

# Monitoring
EVIDENTLY_REPORT_PATH=./monitoring/reports

# Admin & Security
API_SECRET_KEY=newslens-secret-key-super-secure-change-in-production
ALLOW_TRAINING_TRIGGER=true
